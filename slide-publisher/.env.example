# Canva Connect API credentials
# Get these from https://www.canva.com/developers/
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
CANVA_ACCESS_TOKEN=your_canva_access_token

# The Canva design ID to publish (from the Canva URL)
# e.g., https://www.canva.com/design/DAF1234567/edit → DAF1234567
CANVA_DESIGN_ID=your_design_id

# Webhook secret for verifying Canva webhook signatures
CANVA_WEBHOOK_SECRET=your_webhook_secret

# Server config
PORT=3001
PUBLIC_URL=http://localhost:3001

# Deploy target (optional): "vercel", "netlify", or "local"
DEPLOY_TARGET=local
VERCEL_TOKEN=your_vercel_token
VERCEL_PROJECT_ID=your_vercel_project_id
